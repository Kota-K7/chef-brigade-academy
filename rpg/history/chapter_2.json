          "expression": "hatred",
          "background": "forest",
          "characters": [
            {
              "id": "clotilde",
              "expression": "hatred",
              "position": "center"
            }
          ]
        },
        {
          "type": "dialog",
          "character": "clotilde",
          "text": "お父様も、お母様も……殺された。私には何もない……誰も信じられない……！",
