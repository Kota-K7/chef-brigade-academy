          "expression": "normal",
          "background": "forest",
          "characters": [
            {
              "id": "clovis",
              "expression": "normal",
              "position": "center"
            }
          ]
        },
        {
          "type": "dialog",
          "character": "clotilde",
          "text": "来ないで……っ！ どうして……どうして血を流してまで私を助けたのよ……！",
