              "referenceTopicId": "ref_conjugation_patterns",
              "sectionIndices": [
                0
              ]
            }
          ]
        },
        {
          "type": "fixedBattle",
          "enemyName": "父 (食文化の試練)",
          "enemyHp": 7,
          "enemyDamage": 3,
          "criteria": [
            {
              "tag": "#regional_culture",
              "count": 5
